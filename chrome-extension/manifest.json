{
  "manifest_version": 3,
  "name": "Open in stamper",
  "version": "0.1.0",
  "description": "Open the current page or a link in stamper, in a new iTerm2 tab.",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open in stamper",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open the current page in stamper" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
